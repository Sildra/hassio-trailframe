{
  "name": "Trailframe",
  "version": "v0.1.1",
  "slug": "trailframe",
  "description": "Self-hosted photo gallery linking photos with GPS activities (Garmin Connect / GPX)",
  "url": "https://github.com/sildra/hassio-trailframe/tree/main/trailframe",
  "startup": "application",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "boot": "auto",
  "init": false,
  "ingress": false,
  "hassio_api": false,
  "timeout": 30,
  "panel_icon": "mdi:image-multiple",
  "map": [
    {
      "type": "media",
      "read_only": false
    },
    {
      "type": "share",
      "read_only": false
    },
    {
      "type": "addon_config",
      "read_only": false,
      "path": "/addon_config"
    }
  ],
  "ports": {
    "8000/tcp": 8000
  },
  "ports_description": {
    "8000/tcp": "Trailframe web UI - must match the 'port' option"
  },
  "options": {
    "data_path": "/data/trailframe",
    "photos_path": "/media/photos",
    "port": 8000
  },
  "schema": {
    "data_path": "str",
    "photos_path": "str",
    "port": "port"
  }
}
